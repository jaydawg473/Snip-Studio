<Window x:Class="SnipStudio.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SnipStudio.WinUI" Title="Snip Studio">
    <Grid x:Name="Root" Background="{ThemeResource StudioCanvasBrush}" SizeChanged="OnRootSizeChanged">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="StudioToolbarBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="StudioOptionsBrush" Color="#EEF5FE" />
                        <SolidColorBrush x:Key="StudioPrimaryBrush" Color="#0067C0" />
                        <SolidColorBrush x:Key="StudioPrimaryForegroundBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="StudioSelectedBrush" Color="#DDEDFD" />
                        <SolidColorBrush x:Key="StudioSelectedForegroundBrush" Color="#0067C0" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="#DDEDFD" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" Color="#DDEDFD" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="#0067C0" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPointerOver" Color="#0067C0" />
                    <x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double><x:Double x:Key="AppBarButtonContentHeight">20</x:Double><Thickness x:Key="AppBarButtonInnerBorderMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonInnerBorderCompactMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonContentViewboxMargin">12,7,0,7</Thickness><Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,7,0,7</Thickness><Thickness x:Key="AppBarButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarToggleButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarButtonSubItemChevronMargin">-23,13,12,0</Thickness><Thickness x:Key="AppBarButtonSubItemChevronLabelOnRightMargin">-7,13,12,0</Thickness></ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="StudioToolbarBrush" Color="#202020" />
                        <SolidColorBrush x:Key="StudioOptionsBrush" Color="#263444" />
                        <SolidColorBrush x:Key="StudioPrimaryBrush" Color="#0067C0" />
                        <SolidColorBrush x:Key="StudioPrimaryForegroundBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="StudioSelectedBrush" Color="#244A70" />
                        <SolidColorBrush x:Key="StudioSelectedForegroundBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="#244A70" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" Color="#244A70" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
                    <x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double><x:Double x:Key="AppBarButtonContentHeight">20</x:Double><Thickness x:Key="AppBarButtonInnerBorderMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonInnerBorderCompactMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonContentViewboxMargin">12,7,0,7</Thickness><Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,7,0,7</Thickness><Thickness x:Key="AppBarButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarToggleButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarButtonSubItemChevronMargin">-23,13,12,0</Thickness><Thickness x:Key="AppBarButtonSubItemChevronLabelOnRightMargin">-7,13,12,0</Thickness></ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="StudioToolbarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="StudioOptionsBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="StudioPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="StudioPrimaryForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        <SolidColorBrush x:Key="StudioSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="StudioSelectedForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double><x:Double x:Key="AppBarButtonContentHeight">20</x:Double><Thickness x:Key="AppBarButtonInnerBorderMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonInnerBorderCompactMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonContentViewboxMargin">12,7,0,7</Thickness><Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,7,0,7</Thickness><Thickness x:Key="AppBarButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarToggleButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarButtonSubItemChevronMargin">-23,13,12,0</Thickness><Thickness x:Key="AppBarButtonSubItemChevronLabelOnRightMargin">-7,13,12,0</Thickness></ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <x:Double x:Key="AppBarThemeCompactHeight">34</x:Double>
                <x:Double x:Key="AppBarThemeMinHeight">34</x:Double>
                <x:Double x:Key="AppBarButtonContentHeight">20</x:Double>
                <Style x:Key="StudioCaptureActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="8,0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="AllowFocusOnInteraction" Value="False"/>
                </Style>
                <Style TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                    <Setter Property="Width" Value="34" />
                    <Setter Property="MinWidth" Value="34" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Margin" Value="1,0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
                <Style TargetType="AppBarToggleButton" BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}">
                    <Setter Property="Width" Value="34" />
                    <Setter Property="MinWidth" Value="34" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Margin" Value="1,0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
                <Style TargetType="AppBarSeparator" BasedOn="{StaticResource DefaultAppBarSeparatorStyle}"><Setter Property="Margin" Value="4,0" /></Style>
            <Thickness x:Key="AppBarButtonInnerBorderMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonInnerBorderCompactMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonContentViewboxMargin">12,7,0,7</Thickness><Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,7,0,7</Thickness><Thickness x:Key="AppBarButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarToggleButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarButtonSubItemChevronMargin">-23,13,12,0</Thickness><Thickness x:Key="AppBarButtonSubItemChevronLabelOnRightMargin">-7,13,12,0</Thickness></ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource StudioToolbarBrush}" Padding="12,10,12,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ContentControl x:Name="CaptureBar" IsTabStop="False" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CaptureButton" Width="104" Style="{StaticResource StudioCaptureActionStyle}" Background="{ThemeResource StudioPrimaryBrush}" Foreground="{ThemeResource StudioPrimaryForegroundBrush}" Padding="10,0" Margin="0,0,10,0" HorizontalContentAlignment="Left" Click="OnCaptureClicked" AutomationProperties.Name="New snip" ToolTipService.ToolTip="New snip (Ctrl+N)">
                        <Button.Resources><ResourceDictionary><ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#005A9E"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#004E8C"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/></ResourceDictionary>
                            <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1478CF"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#005A9E"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/></ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/></ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries></ResourceDictionary></Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE710;" FontSize="18"/><TextBlock Text="New" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Border x:Name="CaptureModeGroup" Background="{ThemeResource ControlFillColorTertiaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="1,0" Height="34" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Grid><ToggleButton x:Name="ScreenshotModeButton" Width="34" Height="30" MinWidth="0" MinHeight="30" Padding="0" CornerRadius="4" BorderThickness="0" Background="Transparent" IsChecked="True" Click="OnScreenshotModeClicked" AllowFocusOnInteraction="False" AutomationProperties.Name="Screenshot mode" ToolTipService.ToolTip="Screenshot mode"><FontIcon Glyph="&#xE722;" FontSize="18"/></ToggleButton><Border Height="2" Width="14" CornerRadius="1" Background="{ThemeResource StudioPrimaryBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsHitTestVisible="False"/></Grid>
                            <Button x:Name="RecordButton" Width="34" Height="30" MinWidth="0" MinHeight="30" Padding="0" CornerRadius="4" BorderThickness="0" Background="Transparent" Click="OnRecordClicked" AllowFocusOnInteraction="False" AutomationProperties.Name="Record screen and audio" ToolTipService.ToolTip="Record screen and audio"><FontIcon Glyph="&#xE714;" FontSize="18"/></Button>
                        </StackPanel>
                    </Border>
                    <DropDownButton x:Name="CaptureOptionsButton" Width="140" Height="34" MinHeight="34" Padding="8,0" Margin="0,0,10,0" FontSize="12" CornerRadius="4" Background="{ThemeResource StudioOptionsBrush}" BorderThickness="0" HorizontalContentAlignment="Left" AllowFocusOnInteraction="False" AutomationProperties.Name="Capture shape" ToolTipService.ToolTip="Choose the capture shape, then select New">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Grid Width="18" Height="18"><Rectangle Width="16" Height="14" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.25" StrokeDashArray="3,2" RadiusX="1" RadiusY="1"/></Grid><TextBlock x:Name="CaptureModeLabel" Text="Rectangle" VerticalAlignment="Center"/></StackPanel>
                        <DropDownButton.Flyout><MenuFlyout x:Name="CaptureModeMenu">
                            <ToggleMenuFlyoutItem Text="Rectangle" Tag="Rectangle" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M1,3H19V17H1Z M3,5V15H17V5Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem Text="Window" Tag="Window" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M1,2H19V18H1Z M3,7V16H17V7Z M3,4H17V5H3Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem Text="Full screen" Tag="Monitor" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><SymbolIcon Symbol="FullScreen"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem Text="Freeform" Tag="Freeform" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M2,6L7,1L12,4L18,2L20,10L16,12L17,19L9,17L4,20L1,14Z M4,7L3,13L5,17L9,15L15,17L14,11L18,9L17,4L12,6L7,3Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem Text="All monitors" Tag="AllMonitors" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M0,1H12V11H0Z M2,3V9H10V3Z M4,12H8V14H4Z M8,7H20V17H8Z M10,9V15H18V9Z M12,18H16V20H12Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                            <MenuFlyoutSeparator/><MenuFlyoutItem Text="Scrolling capture…" Click="OnScrollingClicked"><MenuFlyoutItem.Icon><PathIcon Data="M2,0H15V4H13V2H4V18H13V16H15V20H2Z M12,7L16,3L20,7H17V13H20L16,17L12,13H15V7Z M6,5H11V7H6Z M6,9H11V11H6Z M6,13H11V15H6Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        </MenuFlyout></DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="DelayButton" Width="70" Height="34" MinHeight="34" MinWidth="0" Padding="4,0" FontSize="12" Background="Transparent" BorderThickness="0" CornerRadius="4" AllowFocusOnInteraction="False" AutomationProperties.Name="Capture delay" ToolTipService.ToolTip="Capture delay">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><FontIcon Glyph="&#xE823;" FontSize="18"/><TextBlock x:Name="CaptureDelayLabel" Text="Off" VerticalAlignment="Center"/></StackPanel>
                        <Button.Flyout><MenuFlyout x:Name="CaptureDelayMenu"><ToggleMenuFlyoutItem Text="Off" Tag="0" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="3 seconds" Tag="3" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="5 seconds" Tag="5" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="10 seconds" Tag="10" Click="OnCaptureDelayClicked"/></MenuFlyout></Button.Flyout>
                    </Button>
                    <Button x:Name="CaptureMoreButton" Style="{StaticResource StudioCaptureActionStyle}" Width="34" Padding="0" Visibility="Collapsed" AutomationProperties.Name="More capture options" ToolTipService.ToolTip="Capture shape and delay">
                        <FontIcon Glyph="&#xE712;" FontSize="18"/>
                        <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Screenshot mode" Click="OnScreenshotModeClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Camera"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Text="Record screen and audio" Click="OnRecordClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Video"/></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutSeparator/><MenuFlyoutSubItem Text="Capture shape"><ToggleMenuFlyoutItem Text="Rectangle" Tag="Rectangle" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M1,3H19V17H1Z M3,5V15H17V5Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><ToggleMenuFlyoutItem Text="Window" Tag="Window" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M1,2H19V18H1Z M3,7V16H17V7Z M3,4H17V5H3Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><ToggleMenuFlyoutItem Text="Full screen" Tag="Monitor" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M0,0H7V2H2V7H0Z M13,0H20V7H18V2H13Z M0,13H2V18H7V20H0Z M18,13H20V20H13V18H18Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><ToggleMenuFlyoutItem Text="Freeform" Tag="Freeform" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M2,6L7,1L12,4L18,2L20,10L16,12L17,19L9,17L4,20L1,14Z M4,7L3,13L5,17L9,15L15,17L14,11L18,9L17,4L12,6L7,3Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><ToggleMenuFlyoutItem Text="All monitors" Tag="AllMonitors" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M0,1H12V11H0Z M2,3V9H10V3Z M4,12H8V14H4Z M8,7H20V17H8Z M10,9V15H18V9Z M12,18H16V20H12Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><MenuFlyoutSeparator/><MenuFlyoutItem Text="Scrolling capture…" Click="OnScrollingClicked"><MenuFlyoutItem.Icon><PathIcon Data="M2,0H15V4H13V2H4V18H13V16H15V20H2Z M12,7L16,3L20,7H17V13H20L16,17L12,13H15V7Z M6,5H11V7H6Z M6,9H11V11H6Z M6,13H11V15H6Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyoutSubItem><MenuFlyoutSubItem Text="Capture delay"><ToggleMenuFlyoutItem Text="Off" Tag="0" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="3 seconds" Tag="3" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="5 seconds" Tag="5" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="10 seconds" Tag="10" Click="OnCaptureDelayClicked"/></MenuFlyoutSubItem></MenuFlyout></Button.Flyout>
                    </Button>
                </StackPanel>
            </ContentControl>
            <CommandBar x:Name="FileBar" Grid.Column="1" MaxWidth="228" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsOpen="False" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto" HorizontalAlignment="Right" Background="Transparent" Padding="0">
                <CommandBar.Resources><ResourceDictionary><x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double></ResourceDictionary></CommandBar.Resources>
                <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="Open" LabelPosition="Collapsed" Click="OnOpenClicked" ToolTipService.ToolTip="Open an image (Ctrl+O)" />
                <AppBarButton x:Name="PasteButton" Icon="Paste" Label="Paste" LabelPosition="Collapsed" Click="OnPasteClicked" ToolTipService.ToolTip="Paste an image (Ctrl+V)" />
                <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save as" LabelPosition="Collapsed" Click="OnSaveClicked" ToolTipService.ToolTip="Save image (Ctrl+S)" IsEnabled="False" />
                <AppBarButton x:Name="CopyButton" Icon="Copy" Label="Copy image or selected text" LabelPosition="Collapsed" Click="OnCopyClicked" ToolTipService.ToolTip="Copy image or selected text (Ctrl+C)" />
                <AppBarButton x:Name="ShareButton" Icon="Share" Label="Share image" LabelPosition="Collapsed" Click="OnShareClicked" ToolTipService.ToolTip="Share image" />
                <AppBarButton x:Name="RetryPreviewButton" Icon="Refresh" Label="Retry preview" LabelPosition="Collapsed" Click="OnRetryPreviewClicked" Visibility="Collapsed" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton Icon="NewWindow" Label="New editor window" Click="OnNewWindowClicked" />
                    <AppBarButton x:Name="PrintButton" Icon="Print" Label="Print image" Click="OnPrintClicked" />
                    <AppBarButton Icon="Folder" Label="Recent files" Click="OnRecentClicked" />
                    <AppBarButton Icon="Video" Label="Open video review" Click="OnVideoReviewClicked" />
                    <AppBarButton x:Name="ReloadExternalButton" Label="Import external editor copy" Click="OnReloadExternalClicked" IsEnabled="False" />
                    <AppBarButton Icon="Setting" Label="Settings" Click="OnSettingsClicked" />
                    <AppBarButton Label="Check for updates" Click="OnUpdatesClicked"><AppBarButton.Icon><FontIcon Glyph="" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Icon="FullScreen" Label="Full screen (F11)" Click="OnFullScreenClicked" />
                    <AppBarButton x:Name="HelpButton" Icon="Help" Label="Help (F1)" Click="OnHelpClicked" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <StackPanel Grid.Row="1" Background="{ThemeResource StudioToolbarBrush}">
            <CommandBar x:Name="ToolBar" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsOpen="False" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Background="Transparent" Margin="12,6,12,6" Padding="0">
                <CommandBar.Resources><ResourceDictionary><x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double></ResourceDictionary></CommandBar.Resources>
                <AppBarToggleButton x:Name="SelectButton" Label="Move" LabelPosition="Collapsed" Click="OnSelectClicked" ToolTipService.ToolTip="Select and move annotations"><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarToggleButton x:Name="PenButton" Icon="Edit" Label="Pen" LabelPosition="Collapsed" IsChecked="True" Click="OnPenClicked" ToolTipService.ToolTip="Pen" />
                <AppBarToggleButton x:Name="HighlighterButton" Icon="Highlight" Label="Highlight" LabelPosition="Collapsed" Click="OnHighlighterClicked" ToolTipService.ToolTip="Highlight text; hold Shift for freehand" />
                <AppBarToggleButton x:Name="ShapesButton" Label="Shapes" LabelPosition="Collapsed" Click="OnShapesClicked" ToolTipService.ToolTip="Shapes and emoji">
                    <AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon>
                    <FlyoutBase.AttachedFlyout><MenuFlyout>
                        <ToggleMenuFlyoutItem x:Name="RectangleButton" Text="Rectangle" Click="OnRectangleClicked" />
                        <ToggleMenuFlyoutItem x:Name="LineButton" Text="Line" Click="OnLineClicked" />
                        <ToggleMenuFlyoutItem x:Name="ArrowButton" Text="Arrow" Click="OnArrowClicked" />
                        <ToggleMenuFlyoutItem x:Name="EllipseButton" Text="Ellipse" Click="OnEllipseClicked" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="EmojiButton" Text="Emoji" Click="OnEmojiClicked" />
                    </MenuFlyout></FlyoutBase.AttachedFlyout>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="TextButton" Label="Add text" LabelPosition="Collapsed" Click="OnTextClicked" ToolTipService.ToolTip="Add or edit text"><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarToggleButton x:Name="EraserButton" Label="Eraser" LabelPosition="Collapsed" Click="OnEraserClicked" ToolTipService.ToolTip="Erase annotations"><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarToggleButton x:Name="CropButton" Label="Crop" LabelPosition="Collapsed" Click="OnCropClicked" ToolTipService.ToolTip="Crop"><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarToggleButton x:Name="RemoveAreaButton" Label="Remove area" LabelPosition="Collapsed" Click="OnRemoveAreaClicked" ToolTipService.ToolTip="Remove captured content"><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarSeparator />
                <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Undo" LabelPosition="Collapsed" Click="OnUndoClicked" ToolTipService.ToolTip="Undo (Ctrl+Z)" IsEnabled="False" />
                <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Redo" LabelPosition="Collapsed" Click="OnRedoClicked" ToolTipService.ToolTip="Redo (Ctrl+Y)" IsEnabled="False" />
                <AppBarButton x:Name="OcrButton" Label="Text actions" LabelPosition="Collapsed" Click="OnOcrClicked" ToolTipService.ToolTip="Image to text"><AppBarButton.Icon><FontIcon Glyph="" /></AppBarButton.Icon></AppBarButton>
                <AppBarSeparator />
                <AppBarElementContainer><Button x:Name="ExternalEditorButton" Style="{StaticResource StudioCaptureActionStyle}" MinWidth="132" Click="OnExternalEditorClicked" ToolTipService.ToolTip="Open a copy in an external image editor"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE70F;" FontSize="18"/><TextBlock Text="Edit in app" VerticalAlignment="Center"/></StackPanel></Button></AppBarElementContainer>
                <CommandBar.SecondaryCommands>
                    <AppBarToggleButton x:Name="PanButton" Label="Move view" Click="OnPanClicked" ToolTipService.ToolTip="Pan the image; middle-drag also pans"><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                    <AppBarToggleButton x:Name="OcrSelectButton" Label="Select recognized text" Click="OnOcrSelectClicked" />
                    <AppBarButton x:Name="ObjectPropertiesButton" Label="Selected object properties" Click="OnObjectPropertiesClicked" />
                    <AppBarButton x:Name="DeleteObjectButton" Icon="Delete" Label="Delete selected object" Click="OnDeleteObjectClicked" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <Grid x:Name="ContextRow" Visibility="Collapsed" Background="{ThemeResource StudioOptionsBrush}" Padding="8,3,6,3" ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CommandBar x:Name="InkContextBar" Visibility="Collapsed" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsOpen="False" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto" HorizontalAlignment="Left" Background="Transparent" Padding="0">
                <CommandBar.Resources><ResourceDictionary><x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double></ResourceDictionary></CommandBar.Resources>
                    <AppBarButton x:Name="ColorButton" Label="Color" LabelPosition="Collapsed" AutomationProperties.Name="Ink color" ToolTipService.ToolTip="Ink color">
                        <AppBarButton.Icon><FontIcon Glyph="" /></AppBarButton.Icon>
                        <AppBarButton.Flyout><Flyout><ColorPicker x:Name="InkColorPicker" Color="#FFE24046" ColorChanged="OnInkColorChanged" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" IsColorChannelTextInputVisible="True" AutomationProperties.Name="Ink color" /></Flyout></AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarElementContainer x:Name="StrokeWidthContainer">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0,6,0"><NumberBox x:Name="StrokeWidthBox" Minimum="1" Maximum="100" Value="3" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact" Width="76" Height="30" MinHeight="30" ValueChanged="OnStrokeWidthChanged" AutomationProperties.Name="Stroke width in image pixels" ToolTipService.ToolTip="Stroke width in image pixels" /><TextBlock Text="px" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                    </AppBarElementContainer>
                    <AppBarElementContainer x:Name="SnapHighlighterContainer" Visibility="Collapsed"><CheckBox x:Name="SnapHighlighterButton" Content="Snap to text" IsChecked="True" MinHeight="30" FontSize="12" Margin="8,0" ToolTipService.ToolTip="Recognize touched words. Hold Shift while dragging for freehand."/></AppBarElementContainer>
                    <AppBarElementContainer x:Name="EraseAllContainer" Visibility="Collapsed"><Button x:Name="EraseAllButton" Content="Erase all annotations" Style="{StaticResource StudioCaptureActionStyle}" Click="OnEraseAllClicked"/></AppBarElementContainer>
                </CommandBar>
                <CommandBar x:Name="ContextBar" Grid.Column="1" Visibility="Collapsed" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsOpen="False" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto" HorizontalAlignment="Left" Background="Transparent" Padding="0">
                <CommandBar.Resources><ResourceDictionary><x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double></ResourceDictionary></CommandBar.Resources>
                    <AppBarElementContainer><ComboBox x:Name="FontFamilyBox" Width="148" MinHeight="30" Height="30" IsEditable="True" SelectedIndex="0" SelectionChanged="OnTextFormatChanged" TextSubmitted="OnFontFamilySubmitted" AutomationProperties.Name="Text font" ToolTipService.ToolTip="Text font"><ComboBoxItem Content="Segoe UI" /><ComboBoxItem Content="Arial" /><ComboBoxItem Content="Calibri" /><ComboBoxItem Content="Consolas" /><ComboBoxItem Content="Times New Roman" /></ComboBox></AppBarElementContainer>
                    <AppBarElementContainer><StackPanel Orientation="Horizontal" Spacing="4" Margin="5,0,4,0"><NumberBox x:Name="TextSizeBox" Width="86" Height="30" MinHeight="30" Minimum="1" Maximum="1024" Value="18" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnTextSizeChanged" AutomationProperties.Name="Text size in image pixels" ToolTipService.ToolTip="Text size in image pixels" /><TextBlock Text="px" FontSize="12" VerticalAlignment="Center" /></StackPanel></AppBarElementContainer>
                    <AppBarToggleButton x:Name="BoldButton" Icon="Bold" Label="Bold" LabelPosition="Collapsed" Click="OnTextFormatClicked" ToolTipService.ToolTip="Bold" />
                    <AppBarToggleButton x:Name="ItalicButton" Icon="Italic" Label="Italic" LabelPosition="Collapsed" Click="OnTextFormatClicked" ToolTipService.ToolTip="Italic" />
                    <AppBarToggleButton x:Name="UnderlineButton" Icon="Underline" Label="Underline" LabelPosition="Collapsed" Click="OnTextFormatClicked" ToolTipService.ToolTip="Underline" />
                    <AppBarElementContainer><Button x:Name="ApplyTextButton" Style="{StaticResource StudioCaptureActionStyle}" Click="OnApplyTextClicked"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE73E;" FontSize="16"/><TextBlock Text="Apply" VerticalAlignment="Center"/></StackPanel></Button></AppBarElementContainer>
                    <AppBarElementContainer><Button x:Name="CancelTextButton" Style="{StaticResource StudioCaptureActionStyle}" Click="OnCancelTextClicked"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="16"/><TextBlock Text="Cancel" VerticalAlignment="Center"/></StackPanel></Button></AppBarElementContainer>
                </CommandBar>
                <Button x:Name="ContextCloseButton" Grid.Column="2" Width="28" MinWidth="0" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Content="×" FontSize="16" Click="OnContextCloseClicked" AutomationProperties.Name="Close tool options" ToolTipService.ToolTip="Close tool options" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <InfoBar x:Name="PreviewNotice" IsOpen="False" IsClosable="True" Severity="Informational" Title="Snip Studio" Message="Changes stay in this editor until you save or copy them." />
            <InfoBar x:Name="ErrorNotice" IsOpen="False" IsClosable="True" Severity="Error" Title="The action could not finish" />
        </StackPanel>
        <local:EditorViewport x:Name="Viewport" Grid.Row="3" MinHeight="32" />
        <Grid x:Name="StatusGrid" Grid.Row="4" Background="{ThemeResource StudioToolbarBrush}" Padding="12,2,12,2" ColumnSpacing="8" RowSpacing="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="StatusInfo" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                <Button x:Name="CancelActionButton" Content="Cancel" MinHeight="24" Padding="8,0" Visibility="Collapsed" Click="OnCancelActionClicked" />
                <TextBlock x:Name="StatusText" Text="Choose New, open an image, or paste from the clipboard." FontSize="12" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel x:Name="ZoomPanel" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="DimensionsText" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button x:Name="ZoomOutButton" Content="−" FontSize="16" Width="26" Height="24" MinWidth="0" MinHeight="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnZoomOutClicked" AutomationProperties.Name="Zoom out" ToolTipService.ToolTip="Zoom out (Ctrl+minus)" IsEnabled="False" />
                <Button x:Name="FitButton" Content="Fit" FontSize="12" Width="30" Height="24" MinWidth="0" MinHeight="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnFitClicked" ToolTipService.ToolTip="Fit to canvas (Ctrl+F)" IsEnabled="False" />
                <DropDownButton x:Name="ActualSizeButton" Content="100%" FontSize="12" Width="90" Height="24" MinWidth="0" MinHeight="24" Padding="4,0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Zoom percentage" ToolTipService.ToolTip="Choose zoom; 100% is actual size (Ctrl+0)" IsEnabled="False">
                    <DropDownButton.Flyout><MenuFlyout>
                        <ToggleMenuFlyoutItem Text="25%" Tag="25" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="50%" Tag="50" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="75%" Tag="75" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="100%" Tag="100" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="125%" Tag="125" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="150%" Tag="150" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="200%" Tag="200" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="300%" Tag="300" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="400%" Tag="400" Click="OnZoomPresetClicked" />
                    </MenuFlyout></DropDownButton.Flyout>
                </DropDownButton>
                <TextBlock x:Name="ZoomText" Visibility="Collapsed" Text="100%" FontSize="12" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Current zoom" />
                <Button x:Name="ZoomInButton" Content="+" FontSize="16" Width="26" Height="24" MinWidth="0" MinHeight="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnZoomInClicked" AutomationProperties.Name="Zoom in" ToolTipService.ToolTip="Zoom in (Ctrl+plus)" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
