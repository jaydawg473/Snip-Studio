<Window x:Class="SnipStudio.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SnipStudio.WinUI" Title="Snip Studio">
    <Grid x:Name="Root" Background="{ThemeResource StudioCanvasBrush}" SizeChanged="OnRootSizeChanged">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="StudioToolbarBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="StudioOptionsBrush" Color="#EEF5FE" />
                        <SolidColorBrush x:Key="StudioPrimaryBrush" Color="#0067C0" />
                        <SolidColorBrush x:Key="StudioPrimaryForegroundBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="StudioSelectedBrush" Color="#DDEDFD" />
                        <SolidColorBrush x:Key="StudioSelectedForegroundBrush" Color="#0067C0" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="#DDEDFD" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" Color="#DDEDFD" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="#0067C0" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPointerOver" Color="#0067C0" />
                    <x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double><x:Double x:Key="AppBarButtonContentHeight">20</x:Double><Thickness x:Key="AppBarButtonInnerBorderMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonInnerBorderCompactMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonContentViewboxMargin">12,7,0,7</Thickness><Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,7,0,7</Thickness><Thickness x:Key="AppBarButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarToggleButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarButtonSubItemChevronMargin">-23,13,12,0</Thickness><Thickness x:Key="AppBarButtonSubItemChevronLabelOnRightMargin">-7,13,12,0</Thickness></ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="StudioToolbarBrush" Color="#202020" />
                        <SolidColorBrush x:Key="StudioOptionsBrush" Color="#263444" />
                        <SolidColorBrush x:Key="StudioPrimaryBrush" Color="#0067C0" />
                        <SolidColorBrush x:Key="StudioPrimaryForegroundBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="StudioSelectedBrush" Color="#244A70" />
                        <SolidColorBrush x:Key="StudioSelectedForegroundBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="#244A70" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" Color="#244A70" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
                    <x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double><x:Double x:Key="AppBarButtonContentHeight">20</x:Double><Thickness x:Key="AppBarButtonInnerBorderMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonInnerBorderCompactMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonContentViewboxMargin">12,7,0,7</Thickness><Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,7,0,7</Thickness><Thickness x:Key="AppBarButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarToggleButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarButtonSubItemChevronMargin">-23,13,12,0</Thickness><Thickness x:Key="AppBarButtonSubItemChevronLabelOnRightMargin">-7,13,12,0</Thickness></ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="StudioToolbarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="StudioOptionsBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="StudioPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="StudioPrimaryForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        <SolidColorBrush x:Key="StudioSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="StudioSelectedForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double><x:Double x:Key="AppBarButtonContentHeight">20</x:Double><Thickness x:Key="AppBarButtonInnerBorderMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonInnerBorderCompactMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonContentViewboxMargin">12,7,0,7</Thickness><Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,7,0,7</Thickness><Thickness x:Key="AppBarButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarToggleButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarButtonSubItemChevronMargin">-23,13,12,0</Thickness><Thickness x:Key="AppBarButtonSubItemChevronLabelOnRightMargin">-7,13,12,0</Thickness></ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <x:Double x:Key="AppBarThemeCompactHeight">34</x:Double>
                <x:Double x:Key="AppBarThemeMinHeight">34</x:Double>
                <x:Double x:Key="AppBarButtonContentHeight">20</x:Double>
                <Style x:Key="StudioCaptureActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="8,0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="AllowFocusOnInteraction" Value="False"/>
                </Style>
                <Style TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                    <Setter Property="Width" Value="34" />
                    <Setter Property="MinWidth" Value="34" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Margin" Value="1,0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
                <Style TargetType="AppBarToggleButton" BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}">
                    <Setter Property="Width" Value="34" />
                    <Setter Property="MinWidth" Value="34" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Margin" Value="1,0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
                <Style TargetType="AppBarSeparator" BasedOn="{StaticResource DefaultAppBarSeparatorStyle}"><Setter Property="Margin" Value="4,0" /></Style>
            <Thickness x:Key="AppBarButtonInnerBorderMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonInnerBorderCompactMargin">2,1,2,1</Thickness><Thickness x:Key="AppBarButtonContentViewboxMargin">12,7,0,7</Thickness><Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,7,0,7</Thickness><Thickness x:Key="AppBarButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarToggleButtonTextLabelOnRightMargin">8,9,12,3</Thickness><Thickness x:Key="AppBarButtonSubItemChevronMargin">-23,13,12,0</Thickness><Thickness x:Key="AppBarButtonSubItemChevronLabelOnRightMargin">-7,13,12,0</Thickness></ResourceDictionary>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="3" Background="{ThemeResource StudioToolbarBrush}" Padding="12,10,12,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ContentControl x:Name="CaptureBar" IsTabStop="False" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CaptureButton" Width="104" Style="{StaticResource StudioCaptureActionStyle}" Background="{ThemeResource StudioPrimaryBrush}" Foreground="{ThemeResource StudioPrimaryForegroundBrush}" Padding="10,0" Margin="0,0,10,0" HorizontalContentAlignment="Left" Click="OnCaptureClicked" AutomationProperties.Name="New snip" ToolTipService.ToolTip="New snip (Ctrl+N)">
                        <Button.Resources><ResourceDictionary><ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#005A9E"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#004E8C"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/></ResourceDictionary>
                            <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1478CF"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#005A9E"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/></ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/></ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries></ResourceDictionary></Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE710;" FontSize="18"/><TextBlock Text="New" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Border x:Name="CaptureModeGroup" Background="{ThemeResource ControlFillColorTertiaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="1,0" Height="34" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Grid><ToggleButton x:Name="ScreenshotModeButton" Width="34" Height="30" MinWidth="0" MinHeight="30" Padding="0" CornerRadius="4" BorderThickness="0" Background="Transparent" IsChecked="True" Click="OnScreenshotModeClicked" AllowFocusOnInteraction="False" AutomationProperties.Name="Screenshot mode" ToolTipService.ToolTip="Screenshot mode"><FontIcon Glyph="&#xE722;" FontSize="18"/></ToggleButton><Border x:Name="ScreenshotModeUnderline" Height="2" Width="14" CornerRadius="1" Background="{ThemeResource StudioPrimaryBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsHitTestVisible="False"/></Grid>
                            <Grid><ToggleButton x:Name="RecordButton" Width="34" Height="30" MinWidth="0" MinHeight="30" Padding="0" CornerRadius="4" BorderThickness="0" Background="Transparent" Click="OnRecordClicked" AllowFocusOnInteraction="False" AutomationProperties.Name="Video mode" ToolTipService.ToolTip="Video mode: select New to choose an area"><FontIcon Glyph="&#xE714;" FontSize="18"/></ToggleButton><Border x:Name="RecordingModeUnderline" Height="2" Width="14" CornerRadius="1" Background="{ThemeResource StudioPrimaryBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
                        </StackPanel>
                    </Border>
                    <DropDownButton x:Name="CaptureOptionsButton" Width="58" MinWidth="58" Height="34" MinHeight="34" Padding="6,0" Margin="0,0,10,0" FontSize="12" CornerRadius="4" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" AllowFocusOnInteraction="False" AutomationProperties.Name="Capture shape: Rectangle" ToolTipService.ToolTip="Rectangle. Choose the capture shape, then select New">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="18" Height="18">
                                <Rectangle x:Name="RectangleCaptureIcon" Width="16" Height="14" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.25" StrokeDashArray="3,2" RadiusX="1" RadiusY="1"/>
                                <PathIcon x:Name="WindowCaptureIcon" Width="18" Height="18" Visibility="Collapsed" Data="M1,2H19V18H1Z M3,7V16H17V7Z M3,4H17V5H3Z"/>
                                <PathIcon x:Name="FullScreenCaptureIcon" Width="18" Height="18" Visibility="Collapsed" Data="M0,0H7V2H2V7H0Z M13,0H20V7H18V2H13Z M0,13H2V18H7V20H0Z M18,13H20V20H13V18H18Z"/>
                                <PathIcon x:Name="FreeformCaptureIcon" Width="18" Height="18" Visibility="Collapsed" Data="M2,6L7,1L12,4L18,2L20,10L16,12L17,19L9,17L4,20L1,14Z M4,7L3,13L5,17L9,15L15,17L14,11L18,9L17,4L12,6L7,3Z"/>
                                <PathIcon x:Name="AllMonitorsCaptureIcon" Width="18" Height="18" Visibility="Collapsed" Data="M0,1H12V11H0Z M2,3V9H10V3Z M4,12H8V14H4Z M8,7H20V17H8Z M10,9V15H18V9Z M12,18H16V20H12Z"/>
                            </Grid>
                            <TextBlock x:Name="CaptureModeLabel" Text="Rectangle" Visibility="Collapsed"/>
                        </StackPanel>
                        <DropDownButton.Flyout><MenuFlyout x:Name="CaptureModeMenu">
                            <ToggleMenuFlyoutItem Text="Rectangle" Tag="Rectangle" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M1,3H19V17H1Z M3,5V15H17V5Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem Text="Window" Tag="Window" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M1,2H19V18H1Z M3,7V16H17V7Z M3,4H17V5H3Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem Text="Full screen" Tag="Monitor" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><SymbolIcon Symbol="FullScreen"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem Text="Freeform" Tag="Freeform" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M2,6L7,1L12,4L18,2L20,10L16,12L17,19L9,17L4,20L1,14Z M4,7L3,13L5,17L9,15L15,17L14,11L18,9L17,4L12,6L7,3Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem Text="All monitors" Tag="AllMonitors" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M0,1H12V11H0Z M2,3V9H10V3Z M4,12H8V14H4Z M8,7H20V17H8Z M10,9V15H18V9Z M12,18H16V20H12Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
                            <MenuFlyoutSeparator Tag="ScreenshotOnly"/><MenuFlyoutItem Text="Scrolling capture…" Tag="ScreenshotOnly" Click="OnScrollingClicked"><MenuFlyoutItem.Icon><PathIcon Data="M2,0H15V4H13V2H4V18H13V16H15V20H2Z M12,7L16,3L20,7H17V13H20L16,17L12,13H15V7Z M6,5H11V7H6Z M6,9H11V11H6Z M6,13H11V15H6Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        </MenuFlyout></DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="DelayButton" Width="70" Height="34" MinHeight="34" MinWidth="0" Padding="4,0" FontSize="12" Background="Transparent" BorderThickness="0" CornerRadius="4" AllowFocusOnInteraction="False" AutomationProperties.Name="Capture delay" ToolTipService.ToolTip="Capture delay">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><FontIcon Glyph="&#xE823;" FontSize="18"/><TextBlock x:Name="CaptureDelayLabel" Text="Off" VerticalAlignment="Center"/></StackPanel>
                        <Button.Flyout><MenuFlyout x:Name="CaptureDelayMenu"><ToggleMenuFlyoutItem Text="Off" Tag="0" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="3 seconds" Tag="3" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="5 seconds" Tag="5" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="10 seconds" Tag="10" Click="OnCaptureDelayClicked"/></MenuFlyout></Button.Flyout>
                    </Button>
                    <Button x:Name="CaptureMoreButton" Style="{StaticResource StudioCaptureActionStyle}" Width="34" Padding="0" Visibility="Collapsed" AutomationProperties.Name="More capture options" ToolTipService.ToolTip="Capture shape and delay">
                        <FontIcon Glyph="&#xE712;" FontSize="18"/>
                        <Button.Flyout><MenuFlyout><ToggleMenuFlyoutItem Text="Screenshot mode" Tag="ScreenshotMode" Click="OnScreenshotModeClicked"><ToggleMenuFlyoutItem.Icon><SymbolIcon Symbol="Camera"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><ToggleMenuFlyoutItem Text="Video mode" Tag="RecordingMode" Click="OnRecordClicked"><ToggleMenuFlyoutItem.Icon><SymbolIcon Symbol="Video"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><MenuFlyoutSeparator/><MenuFlyoutSubItem Text="Capture shape"><ToggleMenuFlyoutItem Text="Rectangle" Tag="Rectangle" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M1,3H19V17H1Z M3,5V15H17V5Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><ToggleMenuFlyoutItem Text="Window" Tag="Window" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M1,2H19V18H1Z M3,7V16H17V7Z M3,4H17V5H3Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><ToggleMenuFlyoutItem Text="Full screen" Tag="Monitor" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M0,0H7V2H2V7H0Z M13,0H20V7H18V2H13Z M0,13H2V18H7V20H0Z M18,13H20V20H13V18H18Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><ToggleMenuFlyoutItem Text="Freeform" Tag="Freeform" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M2,6L7,1L12,4L18,2L20,10L16,12L17,19L9,17L4,20L1,14Z M4,7L3,13L5,17L9,15L15,17L14,11L18,9L17,4L12,6L7,3Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><ToggleMenuFlyoutItem Text="All monitors" Tag="AllMonitors" Click="OnCaptureModeSelected"><ToggleMenuFlyoutItem.Icon><PathIcon Data="M0,1H12V11H0Z M2,3V9H10V3Z M4,12H8V14H4Z M8,7H20V17H8Z M10,9V15H18V9Z M12,18H16V20H12Z"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem><MenuFlyoutSeparator Tag="ScreenshotOnly"/><MenuFlyoutItem Text="Scrolling capture…" Tag="ScreenshotOnly" Click="OnScrollingClicked"><MenuFlyoutItem.Icon><PathIcon Data="M2,0H15V4H13V2H4V18H13V16H15V20H2Z M12,7L16,3L20,7H17V13H20L16,17L12,13H15V7Z M6,5H11V7H6Z M6,9H11V11H6Z M6,13H11V15H6Z"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyoutSubItem><MenuFlyoutSubItem Text="Capture delay" Tag="ScreenshotDelay"><ToggleMenuFlyoutItem Text="Off" Tag="0" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="3 seconds" Tag="3" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="5 seconds" Tag="5" Click="OnCaptureDelayClicked"/><ToggleMenuFlyoutItem Text="10 seconds" Tag="10" Click="OnCaptureDelayClicked"/></MenuFlyoutSubItem></MenuFlyout></Button.Flyout>
                    </Button>
                </StackPanel>
            </ContentControl>
            <CommandBar x:Name="FileBar" Grid.Column="1" MaxWidth="228" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsOpen="False" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto" HorizontalAlignment="Right" Background="Transparent" Padding="0">
                <CommandBar.Resources><ResourceDictionary><x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double></ResourceDictionary></CommandBar.Resources>
                <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="Open" LabelPosition="Collapsed" Click="OnOpenClicked" ToolTipService.ToolTip="Open an image or editable snip (Ctrl+O)" />
                <AppBarButton x:Name="PasteButton" Icon="Paste" Label="Paste" LabelPosition="Collapsed" Click="OnPasteClicked" ToolTipService.ToolTip="Paste an image (Ctrl+V)" />
                <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save" LabelPosition="Collapsed" Click="OnSaveClicked" ToolTipService.ToolTip="Save (Ctrl+S)" IsEnabled="False" />
                <AppBarButton x:Name="CopyButton" Icon="Copy" Label="Copy image" LabelPosition="Collapsed" Click="OnCopyClicked" ToolTipService.ToolTip="Copy the current image" />
                <AppBarButton x:Name="ShareButton" Icon="Share" Label="Share image" LabelPosition="Collapsed" Click="OnShareClicked" ToolTipService.ToolTip="Share image" />
                <AppBarButton x:Name="RetryPreviewButton" Icon="Refresh" Label="Retry preview" LabelPosition="Collapsed" Click="OnRetryPreviewClicked" Visibility="Collapsed" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton Icon="NewWindow" Label="New editor window" Click="OnNewWindowClicked" />
                    <AppBarButton x:Name="SaveAsButton" Icon="Save" Label="Save image as…" Click="OnSaveAsClicked" />
                    <AppBarButton x:Name="SaveEditableProjectButton" Icon="Save" Label="Save editable snip…" Click="OnSaveEditableProjectClicked" />
                    <AppBarButton x:Name="RedactForSharingButton" Label="Redact for sharing…" Click="OnRedactForSharingClicked" />
                    <AppBarButton x:Name="PrintButton" Icon="Print" Label="Print image" Click="OnPrintClicked" />
                    <AppBarButton Icon="Folder" Label="Recent files" Click="OnRecentClicked" />
                    <AppBarButton Icon="Camera" Label="Capture open snips…" Click="OnCaptureOpenSnipsClicked" />
                    <AppBarButton Icon="Folder" Label="Open screenshots folder" Click="OnOpenScreenshotFolderClicked" />
                    <AppBarButton Icon="Folder" Label="Open recordings folder" Click="OnOpenRecordingFolderClicked" />
                    <AppBarButton Label="Refresh taskbar shortcuts" Click="OnRefreshTaskbarClicked" />
                    <AppBarButton Icon="Video" Label="Open video review" Click="OnVideoReviewClicked" />
                    <AppBarButton x:Name="ReloadExternalButton" Label="Import external editor copy" Click="OnReloadExternalClicked" IsEnabled="False" />
                    <AppBarButton Icon="Setting" Label="Settings" Click="OnSettingsClicked" />
                    <AppBarButton Label="Check for updates" Click="OnUpdatesClicked"><AppBarButton.Icon><FontIcon Glyph="" /></AppBarButton.Icon></AppBarButton>
                    <AppBarButton Icon="FullScreen" Label="Full screen (F11)" Click="OnFullScreenClicked" />
                    <AppBarButton x:Name="HelpButton" Icon="Help" Label="Help (F1)" Click="OnHelpClicked" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <Border x:Name="AnnotationToolbarHost" Grid.Row="1" Grid.ColumnSpan="3" Background="{ThemeResource StudioToolbarBrush}">
            <CommandBar x:Name="ToolBar" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsOpen="False" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Background="Transparent" Margin="12,6,12,6" Padding="0">
                <CommandBar.Resources><ResourceDictionary><x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double></ResourceDictionary></CommandBar.Resources>
                <AppBarToggleButton x:Name="SelectButton" Label="Move" LabelPosition="Collapsed" Click="OnSelectClicked" ToolTipService.ToolTip="Move objects. Grab an object when the four-way arrow appears."><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarToggleButton x:Name="PenButton" Icon="Edit" Label="Pen" LabelPosition="Collapsed" IsChecked="True" Click="OnPenClicked" ToolTipService.ToolTip="Pen" />
                <AppBarToggleButton x:Name="HighlighterButton" Icon="Highlight" Label="Highlight" LabelPosition="Collapsed" Click="OnHighlighterClicked" ToolTipService.ToolTip="Highlight text; hold Shift for freehand" />
                <AppBarToggleButton x:Name="ShapesButton" Label="Shapes" LabelPosition="Collapsed" Click="OnShapesClicked" ToolTipService.ToolTip="Shapes: rectangle, ellipse, line and arrow">
                    <AppBarToggleButton.Icon>
                        <FontIcon x:Name="ShapesModeIcon" FontFamily="Segoe UI Symbol" Glyph="&#x2750;" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform><ScaleTransform ScaleX="1.35" ScaleY="1.35" /></FontIcon.RenderTransform>
                        </FontIcon>
                    </AppBarToggleButton.Icon>
                    <FlyoutBase.AttachedFlyout><MenuFlyout Closed="OnShapeFlyoutClosed">
                        <ToggleMenuFlyoutItem x:Name="RectangleButton" Text="Rectangle" Click="OnShapeChoiceClicked" />
                        <ToggleMenuFlyoutItem x:Name="EllipseButton" Text="Ellipse" Click="OnShapeChoiceClicked" />
                        <ToggleMenuFlyoutItem x:Name="LineButton" Text="Line" Click="OnShapeChoiceClicked" />
                        <ToggleMenuFlyoutItem x:Name="ArrowButton" Text="Arrow" Click="OnShapeChoiceClicked" />
                    </MenuFlyout></FlyoutBase.AttachedFlyout>
                </AppBarToggleButton>
                <AppBarButton x:Name="EmojiButton" Label="Emoji" LabelPosition="Collapsed" Click="OnEmojiClicked" ToolTipService.ToolTip="Choose an emoji sticker to add to the snip">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE76E;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarToggleButton x:Name="TextButton" Label="Add text" LabelPosition="Collapsed" Click="OnTextClicked" ToolTipService.ToolTip="Add or edit text"><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarToggleButton x:Name="EraserButton" Label="Eraser" LabelPosition="Collapsed" Click="OnEraserClicked" ToolTipService.ToolTip="Erase annotations"><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarToggleButton x:Name="CropButton" Label="Crop" LabelPosition="Collapsed" Click="OnCropClicked" ToolTipService.ToolTip="Crop"><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarToggleButton x:Name="RemoveAreaButton" Label="Remove area" LabelPosition="Collapsed" Click="OnRemoveAreaClicked" ToolTipService.ToolTip="Remove captured content"><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                <AppBarSeparator />
                <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Undo" LabelPosition="Collapsed" Click="OnUndoClicked" ToolTipService.ToolTip="Undo (Ctrl+Z)" IsEnabled="False" />
                <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Redo" LabelPosition="Collapsed" Click="OnRedoClicked" ToolTipService.ToolTip="Redo (Ctrl+Y)" IsEnabled="False" />
                <AppBarToggleButton x:Name="OcrButton" Label="Text actions" LabelPosition="Collapsed" Click="OnOcrClicked" ToolTipService.ToolTip="Text actions (image to text)">
                    <AppBarToggleButton.Icon>
                        <PathIcon Data="M 2,16.6 L 12.1,6.5 L 15.5,9.9 L 5.4,20 Z M 16,0 L 17,2.8 L 20,4 L 17,5.2 L 16,8 L 15,5.2 L 12,4 L 15,2.8 Z M 5,1 L 5.8,3.2 L 8,4 L 5.8,4.8 L 5,7 L 4.2,4.8 L 2,4 L 4.2,3.2 Z M 18,11 L 18.6,12.4 L 20,13 L 18.6,13.6 L 18,15 L 17.4,13.6 L 16,13 L 17.4,12.4 Z" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarSeparator />
                <AppBarElementContainer><Button x:Name="ExternalEditorButton" Style="{StaticResource StudioCaptureActionStyle}" MinWidth="132" Click="OnExternalEditorClicked" ToolTipService.ToolTip="Open a copy in an external image editor"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE70F;" FontSize="18"/><TextBlock Text="Edit in app" VerticalAlignment="Center"/></StackPanel></Button></AppBarElementContainer>
                <CommandBar.SecondaryCommands>
                    <AppBarToggleButton x:Name="PanButton" Label="Move view" Click="OnPanClicked" ToolTipService.ToolTip="Pan the image; middle-drag also pans"><AppBarToggleButton.Icon><FontIcon Glyph="" /></AppBarToggleButton.Icon></AppBarToggleButton>
                    <AppBarToggleButton x:Name="OcrSelectButton" Label="Select recognized text" Click="OnOcrSelectClicked" ToolTipService.ToolTip="Select recognized text"><AppBarToggleButton.Icon><FontIcon Glyph="&#xE8CB;" /></AppBarToggleButton.Icon></AppBarToggleButton>
                    <AppBarButton x:Name="ObjectPropertiesButton" Icon="Setting" Label="Selected object properties" Click="OnObjectPropertiesClicked" ToolTipService.ToolTip="Selected object properties" />
                    <AppBarButton x:Name="DeleteObjectButton" Icon="Delete" Label="Delete selected object" Click="OnDeleteObjectClicked" ToolTipService.ToolTip="Delete selected object" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Border>
        <Grid x:Name="ContextRow" Grid.Row="2" Grid.ColumnSpan="3" Visibility="Collapsed" Background="{ThemeResource StudioOptionsBrush}" Padding="8,3,6,3" ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CommandBar x:Name="InkContextBar" Visibility="Collapsed" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsOpen="False" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto" HorizontalAlignment="Left" Background="Transparent" Padding="0">
                <CommandBar.Resources><ResourceDictionary><x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double></ResourceDictionary></CommandBar.Resources>
                    <AppBarButton x:Name="ColorButton" Label="Color" LabelPosition="Collapsed" AutomationProperties.Name="Ink color" ToolTipService.ToolTip="Ink color">
                        <AppBarButton.Icon><FontIcon Glyph="" /></AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <Flyout Opening="OnInkFlyoutOpening" Closed="OnInkFlyoutClosed">
                                <StackPanel Spacing="8">
                                    <ColorPicker x:Name="InkColorPicker" Color="#FFE24046" ColorChanged="OnInkColorChanged" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" IsColorChannelTextInputVisible="True" AutomationProperties.Name="Ink color" />
                                    <StackPanel x:Name="InkStrokeControls" Visibility="Collapsed" Spacing="6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <NumberBox x:Name="PickerStrokeWidth" Header="Width (px)" Minimum="1" Maximum="100" Value="3" SmallChange="1" MinWidth="152" SpinButtonPlacementMode="Inline" ValueChanged="OnPickerStrokeWidthChanged" />
                                            <NumberBox x:Name="PickerStrokeOpacity" Grid.Column="1" Header="Opacity (%)" Minimum="1" Maximum="100" Value="100" SmallChange="1" LargeChange="10" MinWidth="152" SpinButtonPlacementMode="Inline" ValueChanged="OnPickerOpacityChanged" />
                                        </Grid>
                                        <Grid x:Name="InkSampleBackground" Height="32" CornerRadius="4" AutomationProperties.Name="Live stroke preview">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Background="#FFFFFFFF" />
                                            <Border Grid.Column="1" Background="#FFD8DDE6" />
                                            <Line x:Name="InkSampleLine" Grid.ColumnSpan="2" X1="0" X2="150" Y1="0" Y2="0" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel x:Name="RecentInkPanel" Spacing="4" Visibility="Collapsed">
                                        <TextBlock Text="Recent colors" />
                                        <StackPanel x:Name="RecentInkSwatches" Orientation="Horizontal" Spacing="4" />
                                    </StackPanel>
                                    <Button Content="Eyedropper" Click="OnInkEyedropperClicked" ToolTipService.ToolTip="Pick a color anywhere on the desktop" />
                                </StackPanel>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarElementContainer x:Name="StrokeWidthContainer">
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="4,0,6,0">
                            <NumberBox x:Name="StrokeWidthBox" Minimum="1" Maximum="100" Value="3" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Hidden" Width="88" Height="30" MinHeight="30" ValueChanged="OnStrokeWidthChanged" AutomationProperties.Name="Stroke width in image pixels" ToolTipService.ToolTip="Stroke width in image pixels" />
                            <StackPanel>
                                <RepeatButton Content="▴" Tag="Up" Click="OnStrokeSizeStepClicked" Width="26" Height="15" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Increase stroke width" />
                                <RepeatButton Content="▾" Tag="Down" Click="OnStrokeSizeStepClicked" Width="26" Height="15" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Decrease stroke width" />
                            </StackPanel>
                            <TextBlock Text="px" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </AppBarElementContainer>
                    <AppBarElementContainer x:Name="DrawLinePatternContainer" Visibility="Collapsed">
                        <DropDownButton x:Name="DrawLinePatternButton" Content="Solid line" AutomationProperties.Name="New shape line style" ToolTipService.ToolTip="Line style for new shapes">
                            <DropDownButton.Flyout><MenuFlyout>
                                <ToggleMenuFlyoutItem Text="Solid" Tag="Solid" Click="OnDrawLinePatternClicked" />
                                <ToggleMenuFlyoutItem Text="Dashed" Tag="Dashed" Click="OnDrawLinePatternClicked" />
                                <ToggleMenuFlyoutItem Text="Dotted" Tag="Dotted" Click="OnDrawLinePatternClicked" />
                            </MenuFlyout></DropDownButton.Flyout>
                        </DropDownButton>
                    </AppBarElementContainer>
                    <AppBarElementContainer x:Name="SnapHighlighterContainer" Visibility="Collapsed"><CheckBox x:Name="SnapHighlighterButton" Content="Snap to text" IsChecked="True" MinHeight="30" FontSize="12" Margin="8,0" ToolTipService.ToolTip="Recognize touched words. Hold Shift while dragging for freehand."/></AppBarElementContainer>
                    <AppBarElementContainer x:Name="InlineStrokePreviewContainer" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas Width="108" Height="30" Margin="8,0,4,0" VerticalAlignment="Center"
                                AutomationProperties.Name="Freehand stroke preview">
                            <Canvas.Clip><RectangleGeometry Rect="0,0,108,30" /></Canvas.Clip>
                            <Path x:Name="InlineStrokePreviewLine" Stretch="None"
                                  Data="M 9,15 C 16,7 23,7 31,15 C 38,23 46,23 54,15 C 62,7 70,7 77,15 C 85,23 92,23 99,15"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </AppBarElementContainer>
                    <AppBarElementContainer x:Name="EraseAllContainer" Visibility="Collapsed"><Button x:Name="EraseAllButton" Content="Erase all annotations" Style="{StaticResource StudioCaptureActionStyle}" Click="OnEraseAllClicked"/></AppBarElementContainer>
                </CommandBar>
                <CommandBar x:Name="ContextBar" Grid.Column="1" Visibility="Collapsed" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsOpen="False" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto" HorizontalAlignment="Left" Background="Transparent" Padding="0">
                <CommandBar.Resources><ResourceDictionary><x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double></ResourceDictionary></CommandBar.Resources>
                    <AppBarElementContainer><ComboBox x:Name="FontFamilyBox" Width="148" MinHeight="30" Height="30" IsEditable="True" SelectedIndex="0" SelectionChanged="OnTextFormatChanged" TextSubmitted="OnFontFamilySubmitted" AutomationProperties.Name="Text font" ToolTipService.ToolTip="Text font"><ComboBoxItem Content="Segoe UI" /><ComboBoxItem Content="Arial" /><ComboBoxItem Content="Calibri" /><ComboBoxItem Content="Consolas" /><ComboBoxItem Content="Times New Roman" /></ComboBox></AppBarElementContainer>
                    <AppBarElementContainer>
                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="5,0,4,0">
                            <NumberBox x:Name="TextSizeBox" Width="98" Height="30" MinHeight="30" Minimum="1" Maximum="1024" Value="18" SmallChange="1" SpinButtonPlacementMode="Hidden" ValueChanged="OnTextSizeChanged" AutomationProperties.Name="Text size in image pixels" ToolTipService.ToolTip="Text size in image pixels" />
                            <StackPanel>
                                <RepeatButton Content="▴" Tag="Up" Click="OnTextSizeStepClicked" Width="26" Height="15" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Increase text size" />
                                <RepeatButton Content="▾" Tag="Down" Click="OnTextSizeStepClicked" Width="26" Height="15" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Decrease text size" />
                            </StackPanel>
                            <TextBlock Text="px" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </AppBarElementContainer>
                    <AppBarToggleButton x:Name="BoldButton" Icon="Bold" Label="Bold" LabelPosition="Collapsed" Click="OnTextFormatClicked" ToolTipService.ToolTip="Bold" />
                    <AppBarToggleButton x:Name="ItalicButton" Icon="Italic" Label="Italic" LabelPosition="Collapsed" Click="OnTextFormatClicked" ToolTipService.ToolTip="Italic" />
                    <AppBarToggleButton x:Name="UnderlineButton" Icon="Underline" Label="Underline" LabelPosition="Collapsed" Click="OnTextFormatClicked" ToolTipService.ToolTip="Underline" />
                    <AppBarButton Icon="Edit" Label="Advanced text…" LabelPosition="Collapsed" Click="OnAdvancedTextClicked" ToolTipService.ToolTip="Advanced text formatting" />
                    <AppBarElementContainer><Button x:Name="ApplyTextButton" Style="{StaticResource StudioCaptureActionStyle}" Click="OnApplyTextClicked"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE73E;" FontSize="16"/><TextBlock Text="Done" VerticalAlignment="Center"/></StackPanel></Button></AppBarElementContainer>
                    <AppBarElementContainer><Button x:Name="CancelTextButton" Style="{StaticResource StudioCaptureActionStyle}" Click="OnCancelTextClicked"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="16"/><TextBlock Text="Cancel" VerticalAlignment="Center"/></StackPanel></Button></AppBarElementContainer>
                </CommandBar>
                <CommandBar x:Name="OcrContextBar" Grid.Column="1" Visibility="Collapsed" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsOpen="False" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto" Background="Transparent" Padding="0">
                    <CommandBar.Resources><ResourceDictionary><x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double></ResourceDictionary></CommandBar.Resources>
                    <AppBarButton Label="Copy all text" Icon="Copy" Click="OnCopyAllOcrClicked" />
                    <AppBarButton x:Name="CopySelectedOcrButton" Label="Copy selection" Icon="Copy" Click="OnCopySelectedOcrClicked" />
                    <AppBarButton Label="Copy as table" Click="OnCopyOcrTableClicked" ToolTipService.ToolTip="Copy rows and columns from recognized text">
                        <AppBarButton.Icon><PathIcon Data="M 2,3 L 18,3 L 18,17 L 2,17 Z M 3.5,4.5 L 3.5,8 L 8,8 L 8,4.5 Z M 9.5,4.5 L 9.5,8 L 16.5,8 L 16.5,4.5 Z M 3.5,9.5 L 3.5,15.5 L 8,15.5 L 8,9.5 Z M 9.5,9.5 L 9.5,15.5 L 16.5,15.5 L 16.5,9.5 Z" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Quick redact…" Click="OnQuickRedactClicked" ToolTipService.ToolTip="Review proposed email and phone redactions">
                        <AppBarButton.Icon><PathIcon Data="M 2,3 L 18,3 L 18,5 L 2,5 Z M 2,8 L 15,8 L 15,12 L 2,12 Z M 2,15 L 18,15 L 18,17 L 2,17 Z" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="EditOcrButton" Label="Edit line" Icon="Edit" Click="OnEditOcrClicked" ToolTipService.ToolTip="Edit the selected line (F2)" />
                    <AppBarButton Label="Translate" Click="OnTranslateOcrClicked" />
                    <AppBarButton x:Name="DeleteSelectedOcrButton" Label="Delete selection" Icon="Delete" Click="OnDeleteObjectClicked" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton Label="Convert to text…" Click="OnConvertOcrClicked" />
                        <AppBarButton Label="Review recognized text…" Click="OnReviewOcrClicked" />
                        <AppBarButton x:Name="EditOcrSelectionButton" Label="Edit text together" Icon="Edit" Click="OnEditOcrSelectionClicked" />
                        <AppBarButton Label="Done" Icon="Accept" Click="OnCloseOcrClicked" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>
                <CommandBar x:Name="ObjectContextBar" Grid.Column="1" Visibility="Collapsed" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsOpen="False" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Background="Transparent" Padding="0">
                    <CommandBar.Resources><ResourceDictionary><x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double></ResourceDictionary></CommandBar.Resources>
                    <AppBarButton x:Name="RotateLeftButton" Width="Auto" Label="Rotate left" Click="OnRotateLeftClicked" IsEnabled="False" ToolTipService.ToolTip="Turn the selected object 90° left">
                        <AppBarButton.Icon>
                            <PathIcon RenderTransformOrigin="0.5,0.5" Data="M 15,4 L 15,1 L 19,5 L 15,9 L 15,6 L 14.3,5.3 C 11.3,2.7 6.7,3.1 4.5,6.6 C 2.4,10 3.9,14.5 7.5,16 C 11,17.5 14.8,15.3 15.5,12 L 17.4,12 C 16.5,17.1 11.7,19.7 6.8,17.8 C 1.9,15.8 0.2,10.1 2.9,5.6 C 5.6,1.3 11.5,0.5 15,4 Z">
                                <PathIcon.RenderTransform><ScaleTransform ScaleX="-1" /></PathIcon.RenderTransform>
                            </PathIcon>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="RotateRightButton" Width="Auto" Label="Rotate right" Click="OnRotateRightClicked" IsEnabled="False" ToolTipService.ToolTip="Turn the selected object 90° right">
                        <AppBarButton.Icon><PathIcon Data="M 15,4 L 15,1 L 19,5 L 15,9 L 15,6 L 14.3,5.3 C 11.3,2.7 6.7,3.1 4.5,6.6 C 2.4,10 3.9,14.5 7.5,16 C 11,17.5 14.8,15.3 15.5,12 L 17.4,12 C 16.5,17.1 11.7,19.7 6.8,17.8 C 1.9,15.8 0.2,10.1 2.9,5.6 C 5.6,1.3 11.5,0.5 15,4 Z" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="SelectionWidthButton" Width="Auto" Label="Width" Visibility="Collapsed" IsEnabled="False"
                                  ToolTipService.ToolTip="Change the selected shape's outline width">
                        <AppBarButton.Icon>
                            <PathIcon Data="M 2,5 L 18,5 L 18,7 L 2,7 Z M 2,10 L 18,10 L 18,13 L 2,13 Z M 2,16 L 18,16 L 18,20 L 2,20 Z" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <Flyout x:Name="SelectionWidthFlyout" Opening="OnSelectionWidthOpening" Closed="OnSelectionWidthClosed">
                                <StackPanel Spacing="8">
                                    <NumberBox x:Name="SelectionWidthBox" Header="Outline width (px)" Value="3"
                                               Minimum="1" Maximum="100" SmallChange="1" MinWidth="148"
                                               SpinButtonPlacementMode="Inline" />
                                    <Button Content="Apply width" Click="OnApplySelectionWidthClicked" />
                                </StackPanel>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarElementContainer x:Name="SelectionLinePatternContainer">
                        <DropDownButton x:Name="SelectionLinePatternButton" Content="Line style" IsEnabled="False" AutomationProperties.Name="Selected shape line style" ToolTipService.ToolTip="Change the selected shape's line style">
                            <DropDownButton.Flyout><MenuFlyout>
                                <ToggleMenuFlyoutItem Text="Solid" Tag="Solid" Click="OnSelectionLinePatternClicked" />
                                <ToggleMenuFlyoutItem Text="Dashed" Tag="Dashed" Click="OnSelectionLinePatternClicked" />
                                <ToggleMenuFlyoutItem Text="Dotted" Tag="Dotted" Click="OnSelectionLinePatternClicked" />
                            </MenuFlyout></DropDownButton.Flyout>
                        </DropDownButton>
                    </AppBarElementContainer>
                    <AppBarButton x:Name="MovePropertiesButton" Width="Auto" Icon="Setting" Label="Properties" Click="OnObjectPropertiesClicked" IsEnabled="False" ToolTipService.ToolTip="Edit the selected object's position, size, or style" />
                </CommandBar>
                <CommandBar x:Name="CropContextBar" Grid.Column="1" Visibility="Collapsed" DefaultLabelPosition="Right" ClosedDisplayMode="Compact" IsOpen="False" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Background="Transparent" Padding="0">
                    <CommandBar.Resources><ResourceDictionary><x:Double x:Key="AppBarThemeCompactHeight">34</x:Double><x:Double x:Key="AppBarThemeMinHeight">34</x:Double></ResourceDictionary></CommandBar.Resources>
                    <AppBarButton x:Name="ApplyCropButton" Width="Auto" Icon="Accept" Label="Apply crop" Click="OnApplyCropClicked" IsEnabled="False" ToolTipService.ToolTip="Apply crop (Enter)" />
                    <AppBarButton x:Name="CancelCropButton" Width="Auto" Icon="Cancel" Label="Cancel" Click="OnCancelCropClicked" ToolTipService.ToolTip="Cancel crop (Esc)" />
                </CommandBar>
                <Button x:Name="ContextCloseButton" Grid.Column="2" Width="28" MinWidth="0" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Content="×" FontSize="16" Click="OnContextCloseClicked" AutomationProperties.Name="Close tool options" ToolTipService.ToolTip="Close tool options" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3">
            <InfoBar x:Name="PreviewNotice" IsOpen="False" IsClosable="True" Severity="Informational" Title="Snip Studio" Message="Changes stay in this editor until you save or copy them." />
            <InfoBar x:Name="ErrorNotice" IsOpen="False" IsClosable="True" Severity="Error" Title="The action could not finish" />
        </StackPanel>
        <ScrollViewer x:Name="SideAnnotationHost" Grid.Row="4" Width="50" Visibility="Collapsed"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                      IsTabStop="False" AutomationProperties.Name="Annotation toolbar" Background="{ThemeResource StudioToolbarBrush}">
            <StackPanel x:Name="SideAnnotationCommands" HorizontalAlignment="Center" Padding="0,6">
                <AppBarButton x:Name="SideExternalEditorButton" Icon="Edit" Label="Edit in app" IsCompact="True"
                              LabelPosition="Collapsed" Click="OnExternalEditorClicked"
                              ToolTipService.ToolTip="Open a copy in an external image editor" />
            </StackPanel>
        </ScrollViewer>
        <local:EditorViewport x:Name="Viewport" Grid.Row="4" Grid.Column="1" MinHeight="32" />
        <TextBlock x:Name="LauncherHint" Grid.Row="4" Grid.Column="1" Text="Press Ctrl+N to take a screenshot." FontSize="14" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/>
        <Grid x:Name="StatusGrid" Grid.Row="7" Grid.ColumnSpan="3" Background="{ThemeResource StudioToolbarBrush}" Padding="12,2,12,2" ColumnSpacing="8" RowSpacing="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="StatusInfo" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                <Button x:Name="CancelActionButton" Content="Cancel" MinHeight="24" Padding="8,0" Visibility="Collapsed" Click="OnCancelActionClicked" />
                <TextBlock x:Name="StatusText" Text="Choose New, open an image, or paste from the clipboard." FontSize="12" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel x:Name="ZoomPanel" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="DimensionsText" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button x:Name="ZoomOutButton" Content="−" FontSize="16" Width="26" Height="24" MinWidth="0" MinHeight="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnZoomOutClicked" AutomationProperties.Name="Zoom out" ToolTipService.ToolTip="Zoom out (Ctrl+minus)" IsEnabled="False" />
                <Button x:Name="FitButton" Content="Fit" FontSize="12" Width="30" Height="24" MinWidth="0" MinHeight="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnFitClicked" ToolTipService.ToolTip="Fit to canvas (Ctrl+F)" IsEnabled="False" />
                <DropDownButton x:Name="ActualSizeButton" Content="100%" FontSize="12" Width="90" Height="24" MinWidth="0" MinHeight="24" Padding="4,0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Zoom percentage" ToolTipService.ToolTip="Choose zoom; 100% is actual size (Ctrl+0)" IsEnabled="False">
                    <DropDownButton.Flyout><MenuFlyout>
                        <ToggleMenuFlyoutItem Text="25%" Tag="25" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="50%" Tag="50" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="75%" Tag="75" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="100%" Tag="100" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="125%" Tag="125" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="150%" Tag="150" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="200%" Tag="200" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="300%" Tag="300" Click="OnZoomPresetClicked" />
                        <ToggleMenuFlyoutItem Text="400%" Tag="400" Click="OnZoomPresetClicked" />
                        <MenuFlyoutItem Text="Custom zoom…" Click="OnCustomZoomClicked" />
                    </MenuFlyout></DropDownButton.Flyout>
                </DropDownButton>
                <TextBlock x:Name="ZoomText" Visibility="Collapsed" Text="100%" FontSize="12" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Current zoom" />
                <Button x:Name="ZoomInButton" Content="+" FontSize="16" Width="26" Height="24" MinWidth="0" MinHeight="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnZoomInClicked" AutomationProperties.Name="Zoom in" ToolTipService.ToolTip="Zoom in (Ctrl+plus)" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
