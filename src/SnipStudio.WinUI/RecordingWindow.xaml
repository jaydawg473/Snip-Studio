<Window
    x:Class="SnipStudio.WinUI.RecordingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Snip Studio — Record video">
    <Grid x:Name="RecordingRoot" Padding="16" RowSpacing="12" SizeChanged="OnLayoutSizeChanged" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnCancelRecordingCountdown"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="RecordingBodyRow" Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="RecordingHeader" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="RecordingHeading" Text="Record video" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="EditInClipchampButton" Content="Edit in Clipchamp" Click="OnEditInClipchampClicked"
                        Visibility="Collapsed" ToolTipService.ToolTip="Send this saved video to Microsoft Clipchamp"/>
                <Button x:Name="OpenVideoButton" Content="Open video" Click="OnOpenVideoClicked"/>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="RecordingBodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12">
                <InfoBar x:Name="VideoNotice" IsOpen="False" IsClosable="True" Severity="Error" Title="The action could not finish"/>
                <StackPanel x:Name="RecordingSettingsPanel" Spacing="10">
                    <TextBlock Text="Choose an area and audio sources, then select Start. Use Stop to finish the recording." TextWrapping="Wrap"/>
                    <ContentControl x:Name="AudioChoicesHost" IsTabStop="False">
                        <StackPanel x:Name="AudioChecksRow" Orientation="Horizontal" Spacing="6">
                            <ToggleButton x:Name="MicrophoneCheck" IsChecked="True" Width="34" Height="34" MinWidth="0" Padding="0" Click="OnRecordingAudioClicked" AutomationProperties.Name="Microphone" ToolTipService.ToolTip="Microphone on — click to mute"><FontIcon Glyph="&#xE720;" FontSize="18"/></ToggleButton>
                            <ToggleButton x:Name="SystemAudioCheck" IsChecked="True" Width="34" Height="34" MinWidth="0" Padding="0" Click="OnRecordingAudioClicked" AutomationProperties.Name="System audio" ToolTipService.ToolTip="System audio on — click to mute"><FontIcon Glyph="&#xE767;" FontSize="18"/></ToggleButton>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
                <StackPanel x:Name="ReviewOptionsPanel" Spacing="8" Visibility="Collapsed">
                    <Grid x:Name="PlaybackPanel" MinHeight="120" Height="280" Background="Black" CornerRadius="6">
                        <MediaPlayerElement x:Name="VideoPlayer" AutoPlay="False" AreTransportControlsEnabled="False" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <TextBlock x:Name="NoVideoText" Text="Record a video or choose Open video to review it here." Foreground="White" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                    </Grid>
                    <Grid x:Name="ReviewPlaybackBar" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="ReviewPlayButton" Click="OnReviewPlayClicked" MinWidth="94" AutomationProperties.Name="Play video">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon x:Name="ReviewPlayIcon" Symbol="Play"/>
                                <TextBlock x:Name="ReviewPlayText" Text="Play" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReviewSoundButton" Grid.Column="1" AutomationProperties.Name="Playback volume" ToolTipService.ToolTip="Playback volume">
                            <Button.Content><SymbolIcon x:Name="ReviewSoundIcon" Symbol="Volume"/></Button.Content>
                            <Button.Flyout>
                                <Flyout x:Name="ReviewSoundFlyout" Opening="OnReviewSoundOpening" Placement="Bottom">
                                    <StackPanel Spacing="8" MinWidth="176">
                                        <Slider x:Name="ReviewVolumeSlider" Header="Playback volume" Maximum="100" Value="100" StepFrequency="1" ValueChanged="OnReviewVolumeChanged"/>
                                        <ToggleButton x:Name="ReviewMuteButton" Content="Mute" Click="OnReviewMuteClicked"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock x:Name="VideoInfoText" Grid.Column="2" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <StackPanel x:Name="CandidatePanel" Visibility="Collapsed" Spacing="4">
                        <TextBlock x:Name="CandidateInfoText" TextWrapping="Wrap"/>
                        <Button x:Name="CopySelectedVideoButton" Content="Save selected file copy" Click="OnCopySelectedVideoClicked" IsEnabled="False" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel x:Name="FilmstripPanel" Spacing="6" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Filmstrip" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FilmstripTime" Grid.Column="1" AutomationProperties.Name="Video position and duration"/>
                        </Grid>
                        <UserControl x:Name="FilmstripInput" IsTabStop="True" UseSystemFocusVisuals="True" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                     AutomationProperties.Name="Video filmstrip"
                                     AutomationProperties.HelpText="Use Left and Right to seek, Home and End to jump. Use the Start and End fields to trim when video details are available."
                                     ToolTipService.ToolTip="Click or drag to seek. Drag a blue handle to trim when available. Escape cancels a drag."
                                     KeyDown="OnFilmstripKeyDown" PointerPressed="OnFilmstripPressed" PointerMoved="OnFilmstripMoved"
                                     PointerReleased="OnFilmstripReleased" PointerCanceled="OnFilmstripCanceled" PointerCaptureLost="OnFilmstripCaptureLost">
                            <Grid Background="Transparent" Padding="10,0">
                                <Grid x:Name="FilmstripTrack" Height="72" SizeChanged="OnFilmstripTrackSizeChanged"
                                      Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <Grid x:Name="FilmstripFrames" IsHitTestVisible="False" Background="#181818" Visibility="Collapsed"/>
                                    <TextBlock x:Name="FilmstripMessage" Text="Reading video details…" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="12" IsHitTestVisible="False"/>
                                    <Canvas x:Name="FilmstripMarks" IsHitTestVisible="False" Visibility="Collapsed">
                                        <Rectangle x:Name="FilmstripBeforeRange" Fill="#A0000000"/>
                                        <Rectangle x:Name="FilmstripAfterRange" Fill="#A0000000"/>
                                        <Border x:Name="FilmstripRange" BorderThickness="0,2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <Border x:Name="FilmstripStartHandle" Width="12" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3">
                                            <Rectangle Width="2" Height="18" Fill="White" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="FilmstripEndHandle" Width="12" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3">
                                            <Rectangle Width="2" Height="18" Fill="White" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="FilmstripPlayhead" Width="3" Background="White" BorderBrush="Black" BorderThickness="0.5"/>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </UserControl>
                        <Grid x:Name="TrimRow" ColumnSpacing="16" RowSpacing="6" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel x:Name="TrimStartActions" Orientation="Horizontal" Spacing="6">
                                <NumberBox x:Name="TrimStartBox" Header="Start (seconds)" Value="0" Minimum="0" SmallChange="0.1" Width="112"/>
                                <Button x:Name="SetStartButton" Content="Set start" ToolTipService.ToolTip="Use the filmstrip playhead as the trim start" Click="OnSetStartClicked" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <StackPanel x:Name="TrimEndActions" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <NumberBox x:Name="TrimEndBox" Header="End (seconds)" Value="0" Minimum="0" SmallChange="0.1" Width="112"/>
                                <Button x:Name="SetEndButton" Content="Set end" ToolTipService.ToolTip="Use the filmstrip playhead as the trim end" Click="OnSetEndClicked" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock x:Name="TrimRangeText" Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="RecordingDestinationText" TextTrimming="CharacterEllipsis" Visibility="Collapsed" IsTextSelectionEnabled="True"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="RecordingFooter" Grid.Row="2" Spacing="4">
            <Grid x:Name="VideoFileActions" ColumnSpacing="6" RowSpacing="0" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button x:Name="CopyVideoFileButton" Content="Copy video file" Click="OnCopyVideoFileClicked" IsEnabled="False"/>
                <Button x:Name="CopyVideoButton" Grid.Column="1" Content="Save copy…" Click="OnCopyVideoClicked" IsEnabled="False"
                        ToolTipService.ToolTip="Save a separate copy of the current video"/>
                <Button x:Name="ReviewExportButton" Grid.Column="2" Content="Export MP4…" IsEnabled="False" ToolTipService.ToolTip="Export a smaller MP4 copy">
                    <Button.Flyout>
                        <Flyout x:Name="ReviewExportFlyout" Placement="Top" Opening="OnVideoExportFlyoutOpening">
                            <StackPanel Spacing="8" Width="280">
                                <TextBlock Text="Export a smaller MP4" FontWeight="SemiBold"/>
                                <ComboBox x:Name="ExportPresetBox" Header="Preset" SelectedIndex="0" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnExportPresetChanged">
                                    <ComboBoxItem Content="Balanced · 720p"/><ComboBoxItem Content="Small · 480p"/>
                                </ComboBox>
                                <TextBlock x:Name="VideoExportEstimateText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                <Button x:Name="ExportVideoButton" Content="Save MP4…" Style="{StaticResource AccentButtonStyle}"
                                        Click="OnReviewExportClicked" IsEnabled="False" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="CompressEmailButton" Grid.Column="3" Content="Compress for email…" IsEnabled="False">
                    <Button.Flyout>
                        <Flyout x:Name="CompressEmailFlyout" Placement="Top" Opening="OnVideoExportFlyoutOpening">
                            <StackPanel Spacing="8" Width="280">
                                <NumberBox x:Name="TargetSizeBox" Header="Maximum file size (MB)" Value="20" Minimum="1" Maximum="1000"
                                           SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" ValueChanged="OnEmailTargetChanged"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="10 MB" Tag="10" Click="OnEmailSizeShortcutClicked"/>
                                    <Button Content="20 MB" Tag="20" Click="OnEmailSizeShortcutClicked"/>
                                    <Button Content="25 MB" Tag="25" Click="OnEmailSizeShortcutClicked"/>
                                </StackPanel>
                                <TextBlock x:Name="EmailExportEstimateText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock Text="Allow room below your email provider’s attachment limit." TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button x:Name="SaveEmailCopyButton" Content="Save email copy…" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                                        Click="OnCompressEmailClicked" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="TrimVideoButton" Grid.Column="5" Content="Save trimmed copy…" Click="OnTrimVideoClicked" IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}"/>
            </Grid>
            <Grid x:Name="RecordActionsRow" ColumnSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="RecordPrimaryActions" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="StartRecordingButton" Content="Start recording" Click="OnStartRecordingClicked" Style="{StaticResource AccentButtonStyle}"/>
                    <Button x:Name="AdjustRecordingAreaButton" Content="Adjust area" Click="OnAdjustRecordingAreaClicked" MinWidth="104"
                            ToolTipService.ToolTip="Move or resize the selected recording area before starting"/>
                    <Button x:Name="StopRecordingButton" Content="Stop and save" Click="OnStopRecordingClicked" IsEnabled="False"/>
                </StackPanel>
                <StackPanel x:Name="RecordUtilityActions" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="ElapsedText" Text="00:00" MinWidth="46" VerticalAlignment="Center" AutomationProperties.Name="Recording duration"/>
                    <ContentControl x:Name="CaptureAudioHost" IsTabStop="False" VerticalAlignment="Center"/>
                    <Button x:Name="RecordingOptionsButton" Width="34" Height="34" MinWidth="0" Padding="0" AutomationProperties.Name="Recording options" ToolTipService.ToolTip="Recording options">
                        <Button.Content><FontIcon Glyph="&#xE713;" FontSize="18"/></Button.Content>
                        <Button.Flyout>
                            <Flyout x:Name="AdvancedRecordingFlyout" Placement="Top" ShouldConstrainToRootBounds="False">
                                <ScrollViewer x:Name="RecordingOptionsScroll" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                                    <StackPanel x:Name="AdvancedRecordingOptionsPanel" Spacing="10" MinWidth="340" MaxWidth="460">
                                        <TextBlock Text="Recording options" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="RegionBox" Header="Recording area" HorizontalAlignment="Stretch" DisplayMemberPath="Name" AutomationProperties.Name="Recording area" SelectionChanged="OnRecordingAreaChanged"/>
                                        <StackPanel x:Name="AreaRow" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="SelectAreaButton" Content="Select area" Click="OnSelectAreaClicked"/>
                                            <Button x:Name="SelectWindowButton" Content="Select window" Click="OnSelectWindowClicked"/>
                                        </StackPanel>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <NumberBox x:Name="FpsBox" Header="Frames/sec" Value="15" Minimum="5" Maximum="30" SmallChange="1" SpinButtonPlacementMode="Compact" Width="120" HorizontalAlignment="Left"/>
                                            <CheckBox x:Name="CursorCheck" Grid.Column="1" Content="Show pointer" IsChecked="True" VerticalAlignment="Bottom"/>
                                        </Grid>
                                        <StackPanel x:Name="DevicesRow" Spacing="10">
                                            <ComboBox x:Name="MicrophoneBox" Header="Microphone device" HorizontalAlignment="Stretch" DisplayMemberPath="Name"/>
                                            <ComboBox x:Name="SystemAudioBox" Header="Output device" HorizontalAlignment="Stretch" DisplayMemberPath="Name"/>
                                            <Button x:Name="RefreshAudioButton" Content="Refresh devices" Click="OnRefreshAudioClicked" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="SelectedAreaSummary" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
            <Button x:Name="CancelVideoButton" Content="Cancel" Click="OnCancelVideoClicked" IsEnabled="False" Visibility="Collapsed" HorizontalAlignment="Left"/>
            <ProgressBar x:Name="VideoProgress" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
            <TextBlock x:Name="VideoStatusText" Text="Ready to record." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Grid>
</Window>
