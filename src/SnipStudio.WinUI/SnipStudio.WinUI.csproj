<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>SnipStudio.WinUI3.Preview</AssemblyName>
    <RootNamespace>SnipStudio.WinUI</RootNamespace>
    <Company>Automation Forge LLC</Company>
    <Product>Snip Studio</Product>
    <Description>Snip Studio WinUI 3 migration preview</Description>
    <Version>0.7.0-preview.7</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.7</FileVersion>
    <ApplicationIcon>../../assets/SnipStudio.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" PrivateAssets="all" />
    <ProjectReference Include="../SnipStudio.Backend/SnipStudio.Backend.csproj" />
    <Content Include="../../assets/app-256.png" Link="Assets/app-256.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/SnipStudio.ico" Link="Assets/SnipStudio.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../translation-bundle/runtime/**/*" Exclude="../../translation-bundle/runtime/**/*.sh" Link="translation/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- WinUI's CopyGeneratedXaml populates the build directory. For this
       unpackaged app, explicitly include the application PRI and compiled XAML
       in the SDK's publish item graph as well; copying just PE/dependency files
       produces an app whose LoadComponent cannot resolve ms-appx:///App.xaml. -->
  <Target Name="IncludeSnipStudioCompiledXamlInPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="Prep_ComputeProcessXamlFiles"
          Condition="'$(WindowsPackageType)' == 'None' and '$(UseWinUI)' == 'true'">
    <Error Condition="'$(TargetDir)' == '' or '$(TargetName)' == ''"
           Text="The application output directory and target name are required to publish WinUI resources." />
    <Error Condition="!Exists('$(TargetDir)$(TargetName).pri')"
           Text="The application PRI is missing. Build the WinUI project before publishing: $(TargetName).pri" />
    <ItemGroup>
      <_SnipStudioRequiredCompiledXaml Include="$(TargetDir)App.xbf;$(TargetDir)MainWindow.xbf;$(TargetDir)EditorViewport.xbf;$(TargetDir)RecordingWindow.xbf" />
    </ItemGroup>
    <Error Condition="!Exists('%(_SnipStudioRequiredCompiledXaml.Identity)')"
           Text="A required compiled application XAML resource is missing: %(_SnipStudioRequiredCompiledXaml.Filename)%(_SnipStudioRequiredCompiledXaml.Extension)" />
    <ItemGroup>
      <!-- GeneratedXamlDest is supplied by the WinUI markup compiler. Exclude
           SDK-derived pages; vendor PRI resources keep their original items. -->
      <_SnipStudioOwnPublishSource Include="@(GeneratedXamlDest->'%(FullPath)')"
          Condition="'%(GeneratedXamlDest.Extension)' == '.xbf' and '%(GeneratedXamlDest.ReferenceSourceTarget)' == ''" />
      <_SnipStudioOwnPublishSource Include="@(_SnipStudioRequiredCompiledXaml);$(TargetDir)$(TargetName).pri" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_SnipStudioOwnPublishSource)">
      <Output TaskParameter="Filtered" ItemName="_SnipStudioOwnPublishSourceDistinct" />
    </RemoveDuplicates>
    <AssignTargetPath Files="@(_SnipStudioOwnPublishSourceDistinct)" RootFolder="$(TargetDir)">
      <Output TaskParameter="AssignedFiles" ItemName="_SnipStudioOwnPublishResource" />
    </AssignTargetPath>
    <Error Condition="!Exists('%(_SnipStudioOwnPublishResource.FullPath)')"
           Text="A compiled application resource is missing: %(_SnipStudioOwnPublishResource.TargetPath)" />
    <Error Condition="$([System.IO.Path]::IsPathRooted('%(_SnipStudioOwnPublishResource.TargetPath)')) or $([System.String]::Copy('%(_SnipStudioOwnPublishResource.TargetPath)').StartsWith('..'))"
           Text="Compiled application resources must publish relative to the application output directory." />
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_SnipStudioOwnPublishResource)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
      <ResolvedFileToPublish Include="@(_SnipStudioOwnPublishResource->'%(FullPath)')">
        <RelativePath>%(_SnipStudioOwnPublishResource.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
